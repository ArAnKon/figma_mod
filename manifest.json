{
  "manifest_version": 3,
  "name": "FigmaMod",
  "version": "1.0.0",
  "description": "Figma-инструменты для веб-разработки",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-inspect": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Включить/выключить инспектор"
    },
    "quick-measure": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Быстрые измерения"
    },
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Включить/выключить расширение"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}